# Optional: comma-separated "SYMBOL:ADDRESS:DECIMALS" list to populate the swap UI's token list,
# e.g. "tUSD:0xabc...:6,tETH:0xdef...:18". Leave blank to show a placeholder message instead.
NEXT_PUBLIC_TOKEN_LIST=
